{
  "name": "ui",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint --deny-warnings && npm run lint:addons && npm run typecheck && npm run format:check && npm run knip",
    "lint:addons": "cd ../sim/panel/web && oxlint --deny-warnings -c ../../../ui/.oxlintrc.json src && oxfmt --check -c ../../../ui/.oxfmtrc.jsonc src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "knip": "KNIP_DISABLE_RAW_TRANSFER=1 knip",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@blueprintjs/core": "^6.18.0",
    "@blueprintjs/icons": "^6.13.0",
    "@elysium/app-admin": "*",
    "@elysium/app-browse": "*",
    "@elysium/app-query": "*",
    "@elysium/shell-api": "*",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@shell/core": "file:../shell/core",
    "echarts": "^6.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@elysium/testing": "*",
    "@playwright/test": "^1.62.1",
    "@shell/build": "file:../shell/build",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "knip": "^6.34.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.79.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "knip": {
    "workspaces": {
      ".": {
        "entry": [
          "addons/*.vite.config.ts"
        ]
      }
    }
  }
}
