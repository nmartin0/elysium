{
  "id": "inbox",
  "name": "Inbox",
  "version": "1",
  "activationEvents": ["onStartup"],
  "contributes": {
    "pages": [
      {
        "id": "inbox",
        "path": "/inbox"
      }
    ],
    "nav": [
      {
        "title": "Inbox",
        "path": "/inbox",
        "subject": "Inbox"
      }
    ],
    "redirects": [
      {
        "from": "/approvals",
        "to": "/inbox?tab=approvals"
      },
      {
        "from": "/identity",
        "to": "/inbox?tab=identity"
      },
      {
        "from": "/notifications",
        "to": "/inbox?tab=notifications"
      }
    ],
    "slots": [
      {
        "id": "inbox.tabs",
        "order": ["approvals", "notifications", "identity", "enrichment", "predictions", "unusual"]
      }
    ]
  },
  "entry": "dist/index.js",
  "styles": ["dist/index.css"]
}
